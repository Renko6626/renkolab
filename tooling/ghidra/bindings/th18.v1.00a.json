{
  "_README": [
    "类型绑定规则 —— 数据在这里，逻辑在 tooling/ghidra/bind_types.py。",
    "改这个文件而不是改脚本；每条规则都要能被 diff 和 revert。",
    "tier 1 = 高置信（签名来自 ExpHP vtable 注释，逐字），默认应用。",
    "tier 2 = 中置信（只绑 this，其余参数保持 Ghidra 推断），--tier 2 才应用。",
    "ambiguous / skip 里的东西**故意不绑**，理由写在 why 里 —— 那是踩过或看穿的坑。"
  ],
  "vtable_rules": [
    {
      "tier": 1,
      "vtable": "zVTableCard",
      "name_pattern": "^(?P<cls>Card[A-Za-z0-9]*)__(?P<slot>.+)$",
      "this": "zCardBaseClass *",
      "why": "zVTableCard 是 ExpHP 唯一给了逐槽 C 签名的 vtable；函数名后缀 == 槽名。this 类型直接取签名首参。",
      "slot_aliases": {
        "on_shoot": "on_tick_shooters",
        "__on_shoot_2": "on_bullet_created",
        "method_3C": "get_bomb_timer"
      },
      "_note_pattern": "类名字符集**不能含下划线**，否则 CardReimu1____on_load__2 会被贪婪吃成槽名 '2'。踩过。",
      "_note_aliases": "ExpHP 的槽名与它给函数起的名不一致（槽 on_tick_shooters / 函数 __on_shoot 等）。别名按 CardBaseClass__* 的地址序逐个对过 0x413010..0x413170。",
      "_not_bound": "CardMomoyo__on_bullet_init 疑为槽 0x28，但没逐字核对过 vtable，故意不绑。",
      "slot_param_overrides": {
        "_why": "ExpHP 的 vtable 注释有错/有含糊，这里按一手结论逐槽订正。null = 保持 ExpHP 的。",
        "on_player_death_after_deathbomb": [
          null,
          {
            "name": "death_save_acc",
            "type": "uint",
            "why": "ExpHP 标 struct zPlayer*，实为**救命累加器**：Player__on_tick__body case 4 是 acc |= vtable[0x0c](acc)，起始 0；CardEirin 0x40A4F0 判 acc==0 才出手。"
          }
        ],
        "recharge": [
          null,
          {
            "name": "drop_pos",
            "type": "float *",
            "why": "ExpHP 标 int32_t __unknown1，实为掉落坐标：Enemy__drop_items_and_notify_cards 0x430510 传的是 spawn 位置。"
          },
          {
            "name": "drop_counts",
            "type": "int *",
            "why": "ExpHP 标 int32_t __unknown2，实为敌人逐类道具掉落数表（enemy+0x04 起）：CardYachie 0x40D630 读 drop_counts[1] 即 type2 金钱数。"
          }
        ]
      }
    }
  ],
