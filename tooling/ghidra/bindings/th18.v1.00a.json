  "ambiguous": [
    {
      "pattern": "^Player__",
      "why": "this 有时是 zPlayer* 有时是 zPlayerInner*（inner 在 zPlayer+0x620）。实证：Player__on_tick__body 读 +0x476ac 走 zPlayer；而 Player__repopulate_options_and_notify_cards 的实参是 &PLAYER_PTR->inner。整族一刀切必错，要逐个定。"
    },
    {
      "pattern": "^(Bomb|BombReimu|BombMarisa|BombSakuya|BombSanae)__",
      "why": "ExpHP 没给 zBomb 结构体（只有 zVTableBomb），没有可绑的 this 类型。别把『没命名』当『不存在』——机制是有的，见 engine/card/th18/06-resource-economy.md §1。"
    },
    {
      "pattern": "^(GameThread|AbilityShop|AbilityText|Gui|GuiMsgVm)__",
      "why": "ExpHP 无对应结构体（zGui/zGuiMsgVm 有，但这些函数的 this 未核对过是不是它）。要绑先各自反一个函数确认 this。"
    },
    {
      "pattern": "^(TableCardData|CardCollection|CardShop|CardData)__",
      "why": "这些不是方法，是自由函数（第一个参数是 card_id 或 zTableCardData*，不是 this）。一刀切会把参数语义搞反。"
    }
  ],
  "skip_addrs": [],
  "overrides": [],
  "subclass_structs": {
    "_why": "绑到 zCardBaseClass(0x54) 会让子类字段被渲染成 self[1].card_id —— 那是误导（真身是 card+0x58）。所以给每个 >0x54 的卡类建一个同名带填充的结构体：复制 zCardBaseClass 的字段，尾部留 undefined，于是 card+0x58 显示成 field_0x58。",
    "_provenance": "大小取自 AbilityManager__allocate_new_card 0x411460 每个 case 的 operator new 实参；类名由该 case 写入的 vtable 的 +0x50 槽（operator_delete）反查。56 个类无一有歧义。",
    "_maintenance": "改了 zCardBaseClass 的布局要重跑 bind_types.py --apply --force，子类结构体不会自己跟。",
    "base": "zCardBaseClass",
    "name_template": "z{cls}",
    "sizes": {
